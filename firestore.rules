rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function incoming() {
      return request.resource.data;
    }
    function existing() {
      return resource.data;
    }
    function isSignedIn() {
      return request.auth != null;
    }

    // Validation helper for School entity
    function isValidSchool(data) {
      return data.keys().hasAll(['id', 'name', 'code', 'createdAt']) &&
        data.id is string && isValidId(data.id) &&
        data.name is string && data.name.size() >= 3 && data.name.size() <= 120 &&
        data.code is string && data.code.size() >= 2 && data.code.size() <= 10 &&
        (!('motto' in data) || (data.motto is string && data.motto.size() <= 200)) &&
        (!('address' in data) || (data.address is string && data.address.size() <= 250)) &&
        (!('themeColor' in data) || (data.themeColor is string && data.themeColor.size() <= 25)) &&
        (!('adminEmail' in data) || (data.adminEmail is string && data.adminEmail.size() <= 120)) &&
        (!('adminPhone' in data) || (data.adminPhone is string && data.adminPhone.size() <= 30)) &&
        (!('accreditationNumber' in data) || (data.accreditationNumber is string && data.accreditationNumber.size() <= 60)) &&
        (!('registeredBy' in data) || (data.registeredBy is string && data.registeredBy.size() <= 80)) &&
        (!('isOta' in data) || (data.isOta is bool)) &&
        (!('status' in data) || (data.status in ['ACTIVE', 'ARCHIVED']));
    }

    function isValidAppStoreDoc(key, data) {
      return key is string && key.size() >= 3 && key.size() <= 128 &&
        data.keys().hasAll(['updatedAt']) &&
        data.updatedAt is number;
    }

    function isValidSyncDiagnosticPing(data) {
      return data.keys().hasAll(['deviceId', 'timestamp']) &&
        data.deviceId is string && data.deviceId.size() > 0 && data.deviceId.size() <= 128 &&
        data.timestamp is number &&
        (!('deviceLabel' in data) || (data.deviceLabel is string && data.deviceLabel.size() <= 128));
    }

    // Schools collection: schema-validated institutional registry
    match /schools/{schoolId} {
      allow read: if true;
      allow create, update: if isValidSchool(incoming());
      allow delete: if isValidId(schoolId);
    }

    // Dynamic application sync collection for real-time schedule & faculty synchronization
    match /ota_app_store/{key} {
      allow read: if true;
      allow create, update: if isValidAppStoreDoc(key, incoming());
      allow delete: if isValidId(key);
    }

    // Cross-device Sync Diagnostics collection
    match /ota_sync_diagnostics/{pingId} {
      allow read: if true;
      allow create, update: if isValidId(pingId) && isValidSyncDiagnosticPing(incoming());
      allow delete: if isValidId(pingId);
    }

    // Default deny all unknown collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
